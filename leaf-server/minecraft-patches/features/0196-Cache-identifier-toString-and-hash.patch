From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BukkitPatcher <bukkitpatcher@local.dev>
Date: Sun, 16 Aug 2026 13:45:25 +0900
Subject: [PATCH] Cache identifier toString and hash

Cache toString and hash to reduce allocations. Use lazy cache to
prevent cache inconsistency caused by operations that don't use the
constructor, e.g. Gson serialization or Reflection.

Backported from Leaf ver/26.2 (original author: OverwriteMC) to
ver/1.21.4. Class is named ResourceLocation here (renamed to
Identifier in later MC versions); otherwise identical.

diff --git a/net/minecraft/resources/ResourceLocation.java b/net/minecraft/resources/ResourceLocation.java
index ea8cfa76093c70a44d065c1f80adaa9127fe4e07..73a718416c5f64e00fb6aa9cc69566cf556e3798 100644
--- a/net/minecraft/resources/ResourceLocation.java
+++ b/net/minecraft/resources/ResourceLocation.java
@@ -35,6 +35,10 @@ public final class ResourceLocation implements Comparable<ResourceLocation> {
     public static final String PAPER_NAMESPACE = "paper"; // Paper
     private final String namespace;
     private final String path;
+    // Leaf start - Cache identifier toString and hash
+    private String identifierStr;
+    private int hash;
+    // Leaf end - Cache identifier toString and hash
 
     private ResourceLocation(String namespace, String path) {
         assert isValidNamespace(namespace);
@@ -145,7 +149,14 @@ public final class ResourceLocation implements Comparable<ResourceLocation> {
 
     @Override
     public String toString() {
-        return this.namespace + ":" + this.path;
+        // Leaf start - Cache identifier toString and hash
+        String identifierStr = this.identifierStr;
+        if (identifierStr == null) {
+            identifierStr = this.namespace + ":" + this.path;
+            this.identifierStr = identifierStr;
+        }
+        return identifierStr;
+        // Leaf end - Cache identifier toString and hash
     }
 
     @Override
@@ -158,7 +169,14 @@ public final class ResourceLocation implements Comparable<ResourceLocation> {
 
     @Override
     public int hashCode() {
-        return 31 * this.namespace.hashCode() + this.path.hashCode();
+        // Leaf start - Cache identifier toString and hash
+        int hash = this.hash;
+        if (hash == 0) {
+            hash = 31 * this.namespace.hashCode() + this.path.hashCode();
+            this.hash = hash;
+        }
+        return hash;
+        // Leaf end - Cache identifier toString and hash
     }
 
     @Override
