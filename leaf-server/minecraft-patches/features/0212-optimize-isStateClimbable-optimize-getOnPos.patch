From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BukkitPatcher <bukkitpatcher@local.dev>
Date: Sun, 16 Aug 2026 14:57:04 +0900
Subject: [PATCH] optimize isStateClimbable; optimize getOnPos

- isStateClimbable: replace two separate tag/instanceof lookups with
  a single tagFlag bitmask check.
- getOnPos: replace level.getBlockState() (which itself resolves a
  chunk) with a single getChunkIfLoaded() + chunk.getBlockStateFinal(),
  and use cached tagFlag bits instead of three separate tag/instanceof
  lookups for the fence/wall/fence-gate check.

Both depend on the tagFlag cache added in the previous commit.
Backported from Leaf ver/26.2 (original author: hayanesuru) to
ver/1.21.4.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index f701a306206b4888c85d6006e019f2c3d89437d3..a145ecbd189a12fdf612de6339cdf8f1aa33be6d 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -1348,7 +1348,7 @@ public abstract class Entity implements SyncedDataHolder, Nameable, EntityAccess
     }
 
     private boolean isStateClimbable(BlockState state) {
-        return state.is(BlockTags.CLIMBABLE) || state.is(Blocks.POWDER_SNOW);
+        return (state.tagFlag & org.dreeam.leaf.util.BlockMasks.IS_STATE_CLIMBABLE) != 0; // Leaf - optimize isStateClimbable
     }
 
     private boolean vibrationAndSoundEffectsFromBlock(BlockPos pos, BlockState state, boolean playStepSound, boolean broadcastGameEvent, Vec3 entityPos) {
@@ -1411,24 +1411,28 @@ public abstract class Entity implements SyncedDataHolder, Nameable, EntityAccess
     }
 
     protected BlockPos getOnPos(float yOffset) {
-        if (this.mainSupportingBlockPos.isPresent() && this.level().getChunkIfLoadedImmediately(this.mainSupportingBlockPos.get()) != null) { // Paper - ensure no loads
+        // Leaf start - optimize getOnPos
+        if (this.mainSupportingBlockPos.isPresent() /*&& this.level().getChunkIfLoadedImmediately(this.mainSupportingBlockPos.get()) != null*/) { // Paper - ensure no loads
             BlockPos blockPos = this.mainSupportingBlockPos.get();
-            if (!(yOffset > 1.0E-5F)) {
-                return blockPos;
-            } else {
-                BlockState blockState = this.level().getBlockState(blockPos);
-                return (!(yOffset <= 0.5) || !blockState.is(BlockTags.FENCES))
-                        && !blockState.is(BlockTags.WALLS)
-                        && !(blockState.getBlock() instanceof FenceGateBlock)
+            net.minecraft.world.level.chunk.LevelChunk chunk = this.level().getChunkIfLoaded(blockPos);
+            if (chunk != null) {
+                if (!(yOffset > 1.0E-5F)) {
+                    return blockPos;
+                }
+                BlockState blockState = chunk.getBlockStateFinal(blockPos.getX(), blockPos.getY(), blockPos.getZ());
+                int flags = blockState.tagFlag;
+                return (!(yOffset <= 0.5) || (flags & org.dreeam.leaf.util.BlockMasks.FENCE_TAG) == 0)
+                        && (flags & org.dreeam.leaf.util.BlockMasks.WALL_TAG) == 0
+                        && (flags & org.dreeam.leaf.util.BlockMasks.FENCE_GATE_CL) == 0
                     ? blockPos.atY(Mth.floor(this.position.y - yOffset))
                     : blockPos;
             }
-        } else {
-            int floor = Mth.floor(this.position.x);
-            int floor1 = Mth.floor(this.position.y - yOffset);
-            int floor2 = Mth.floor(this.position.z);
-            return new BlockPos(floor, floor1, floor2);
         }
+        int floor = Mth.floor(this.position.x);
+        int floor1 = Mth.floor(this.position.y - yOffset);
+        int floor2 = Mth.floor(this.position.z);
+        return new BlockPos(floor, floor1, floor2);
+        // Leaf end - optimize getOnPos
     }
 
     protected float getBlockJumpFactor() {
