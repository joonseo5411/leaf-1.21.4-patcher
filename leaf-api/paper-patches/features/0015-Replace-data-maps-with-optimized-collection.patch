From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BukkitPatcher <bukkitpatcher@local.dev>
Date: Sun, 16 Aug 2026 17:00:07 +0900
Subject: [PATCH] Replace data maps with optimized collection

Swap boxed HashMap<Integer/Byte/Character, T> lookup tables for
primitive-key fastutil maps (Int2ReferenceOpenHashMap etc.) across
11 legacy Bukkit enum/material classes, avoiding autoboxing on every
lookup/populate.

Backported from Leaf ver/26.2 (original author: OverwriteMC) to
ver/1.21.4.

diff --git a/src/main/java/org/bukkit/ChatColor.java b/src/main/java/org/bukkit/ChatColor.java
index f283bcabff7fe6eede6cf4344537e43048c35166..6187e2c4ae7c3230d7e93924ca3355763abe4905 100644
--- a/src/main/java/org/bukkit/ChatColor.java
+++ b/src/main/java/org/bukkit/ChatColor.java
@@ -246,8 +246,8 @@ public enum ChatColor {
     private final char code;
     private final boolean isFormat;
     private final String toString;
-    private static final Map<Integer, ChatColor> BY_ID = Maps.newHashMap();
-    private static final Map<Character, ChatColor> BY_CHAR = Maps.newHashMap();
+    private static final it.unimi.dsi.fastutil.ints.Int2ReferenceMap<ChatColor> BY_ID = new it.unimi.dsi.fastutil.ints.Int2ReferenceOpenHashMap<>(); // Leaf - Replace data maps with optimized collection
+    private static final it.unimi.dsi.fastutil.chars.Char2ReferenceMap<ChatColor> BY_CHAR = new it.unimi.dsi.fastutil.chars.Char2ReferenceOpenHashMap<>(); // Leaf - Replace data maps with optimized collection
 
     private ChatColor(char code, int intCode) {
         this(code, intCode, false);
